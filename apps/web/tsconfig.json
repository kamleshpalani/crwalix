{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@crawlix/shared": ["../../packages/shared/src/index.ts"],
      "@crawlix/providers": ["../../packages/providers/src/index.ts"],
      "@crawlix/scoring": ["../../packages/scoring/src/index.ts"],
      "@crawlix/db": ["../../packages/db/src/index.ts"]
    },
    "types": ["node", "react", "react-dom"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
