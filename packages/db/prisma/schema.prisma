// packages/db/prisma/schema.prisma
// Crawlix SaaS — multi-tenant schema.
// Notes:
//  - Every tenant-scoped table has organizationId + a Postgres RLS policy
//    (see packages/db/migrations/0001_rls.sql — added in Phase 1).
//  - JSONB is used for raw/normalized provider payloads and audit metadata.
//  - The previously scaffolded /packages/database is deprecated in favor of
//    this package and will be removed once Phase 1 code migrates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum LeadStatus {
  NEW
  VERIFIED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  NOT_INTERESTED
  CONVERTED
  CLOSED
  // Deprecated values, retained for backwards compatibility with rows
  // created before the lifecycle was redesigned. Treat as legacy.
  ENRICHED
  REVIEWED
  EXPORTED
  ARCHIVED
}

enum WebsiteStatus {
  EXISTS
  EXISTS_MISSING_IN_SOURCE
  LIKELY_NONE
  HIGH_CONFIDENCE_NONE
  UNKNOWN
}

enum PriorityTier {
  HIGH
  MEDIUM
  LOW
}

enum EnrichmentKind {
  WEBSITE_VALIDATION
  EMAIL
  EMAIL_VERIFY
  SOCIAL
  COMPANY
  CONTACT
}

enum EnrichmentStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum ExportStatus {
  QUEUED
  BUILDING
  READY
  FAILED
}

enum ExportFormat {
  CSV
  XLSX
  GOOGLE_SHEETS
}

enum BusinessStatus {
  OPERATIONAL
  CLOSED_TEMP
  CLOSED_PERM
  UNKNOWN
}

model User {
  id          String   @id @default(uuid())
  clerkId     String   @unique
  email       String   @unique
  fullName    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships OrganizationMember[]
  auditLogs   AuditLog[]
}

model Organization {
  id               String   @id @default(uuid())
  slug             String   @unique
  clerkOrgId       String?  @unique
  name             String
  plan             Plan     @default(FREE)
  stripeCustomerId String?  @unique
  /// Optional outbound webhook fired when newly-discovered leads arrive
  /// from a scheduled search. Slack-compatible incoming webhooks work too.
  notificationWebhookUrl String?
  /// Optional digest email recipient. Defaults to the org owner if blank.
  notificationEmail      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  members          OrganizationMember[]
  projects         Project[]
  subscription     Subscription?
  usageLogs        UsageLog[]
  apiKeys          ApiKey[]
  providerConfigs  ProviderConfig[]
  outreachSettings OutreachSettings?
  outreachSuppressions OutreachSuppression[]
  notifications    Notification[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Subscription {
  id                   String    @id @default(uuid())
  organizationId       String    @unique
  stripeSubscriptionId String?   @unique
  plan                 Plan
  status               String
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id])
}

model UsageLog {
  id             String   @id @default(uuid())
  organizationId String
  kind           String
  units          Int
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  /// Optional link back to the deal that triggered project kickoff.
  /// One project per won deal — UNIQUE so the kickoff is idempotent.
  dealId         String?  @unique
  /// Convenience denorm of the originating lead (for quick filters).
  leadId         String?
  /// PLANNING | ACTIVE | PAUSED | COMPLETED | ARCHIVED. Plain text so we
  /// don't have to ship a Postgres enum migration just for five values.
  status         String   @default("PLANNING")
  kickoffAt      DateTime?
  completedAt    DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searches       Search[]
  leadLists      LeadList[]
  tasks          ProjectTask[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, leadId])
}

/// Kickoff checklist items for a Project. Created by `seed_default_project_tasks`
/// when a deal flips to a Won stage; manually editable thereafter.
model ProjectTask {
  id              String   @id @default(uuid())
  organizationId  String
  projectId       String
  title           String
  description     String?
  /// TODO | IN_PROGRESS | DONE | BLOCKED.
  status          String   @default("TODO")
  /// Display order within the project. Lower = top.
  position        Int      @default(0)
  dueAt           DateTime?
  assigneeUserId  String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, position])
  @@index([organizationId, status])
}

model Search {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  niche          String?
  keyword        String?
  country        String?
  state          String?
  city           String?
  postalCode     String?
  radiusMeters   Int?
  resultLimit    Int      @default(100)
  provider       String
  /// Per-search ingest filter: ALL | NO_WEBSITE | HIGH_OR_MED.
  leadFocus      String   @default("ALL")
  /// Recurring schedule. NULL or 'NONE' = one-shot. Allowed: NONE | DAILY | WEEKLY | MONTHLY.
  scheduleFrequency String  @default("NONE")
  /// When the next scheduled run should fire (UTC). Null when one-shot.
  nextRunAt         DateTime?
  /// Last time a run was kicked off for this search.
  lastRunAt         DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs           SearchRun[]

  @@index([organizationId, projectId])
  @@index([scheduleFrequency, nextRunAt])
}

model SearchRun {
  id             String    @id @default(uuid())
  organizationId String
  searchId       String
  status         JobStatus @default(QUEUED)
  provider       String
  totalFetched   Int       @default(0)
  totalInserted  Int       @default(0)
  totalDuplicate Int       @default(0)
  cost           Int       @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  search         Search    @relation(fields: [searchId], references: [id], onDelete: Cascade)
  leads          LeadSource[]

  @@index([organizationId, searchId])
}

model Lead {
  id                String   @id @default(uuid())
  organizationId    String
  externalPlaceId   String
  provider          String
  name              String
  nameNormalized    String
  categoryPrimary   String?
  categories        String[] @default([])
  phone             String?
  phoneNormalized   String?
  email             String?
  emailNormalized   String?
  ownerName         String?
  facebookUrl       String?
  instagramUrl      String?
  googleProfileUrl  String?
  /// Recommended sales pitches derived from website audit + priority.
  /// Values: NEW_WEBSITE | REDESIGN | SEO | BOOKING_SYSTEM | CONTACT_FORM | MOBILE_REDESIGN.
  servicePitch      String[]       @default([])
  website           String?
  websiteStatus     WebsiteStatus  @default(UNKNOWN)
  /// Outcome of latest website-validation enrichment.
  /// One of WebsiteHealth (FRESH | NEEDS_REVIEW | OUTDATED | UNREACHABLE | NOT_AUDITED).
  websiteHealth     String         @default("NOT_AUDITED")
  /// 0–100 health score. 100 = pristine modern site, 0 = unreachable.
  websiteHealthScore Int?
  /// Structured findings (issues + signals) from the auditor.
  websiteAudit      Json?
  websiteAuditedAt  DateTime?
  sourceUrl         String?
  address           String?
  addressNormalized String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  lat               Float?
  lng               Float?
  businessStatus    BusinessStatus @default(UNKNOWN)
  rating            Float?
  reviewCount       Int?
  score             Int?
  priorityTier      PriorityTier?
  scoreBreakdown    Json?
  /// Business-scale classification (SME | MID_MARKET | LARGE | UNKNOWN).
  /// Derived from public signals (categories, reviews, website tech, etc.).
  businessScale     String         @default("UNKNOWN")
  /// 0–100 confidence in the classification.
  businessScaleConfidence Int?
  /// Contributing signals + raw bucket scores from the classifier.
  businessScaleSignals Json?
  status            LeadStatus     @default(NEW)
  notes             String?
  tags              String[]       @default([])
  firstSeenAt       DateTime       @default(now())
  lastSeenAt        DateTime       @default(now())
  lastEnrichedAt    DateTime?
  rawPayload        Json
  normalizedPayload Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sources           LeadSource[]
  enrichments       Enrichment[]
  scores            LeadScore[]
  listMemberships   LeadListItem[]

  @@unique([organizationId, provider, externalPlaceId])
  @@index([organizationId, nameNormalized])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, websiteStatus])
  @@index([organizationId, priorityTier, score])
}

model LeadSource {
  id          String   @id @default(uuid())
  leadId      String
  searchRunId String
  provider    String
  rawPayload  Json
  createdAt   DateTime @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  searchRun   SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadScore {
  id             String       @id @default(uuid())
  leadId         String
  score          Int
  priorityTier   PriorityTier
  breakdown      Json
  rulesetVersion String
  createdAt      DateTime     @default(now())
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Enrichment {
  id             String           @id @default(uuid())
  organizationId String
  leadId         String
  kind           EnrichmentKind
  provider       String
  status         EnrichmentStatus @default(QUEUED)
  attempts       Int              @default(0)
  rawResult      Json?
  normalized     Json?
  error          String?
  cost           Int              @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, kind])
}

model LeadList {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  description    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items          LeadListItem[]

  @@index([organizationId])
}

model LeadListItem {
  id        String   @id @default(uuid())
  listId    String
  leadId    String
  createdAt DateTime @default(now())
  list      LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([listId, leadId])
}

model ExportJob {
  id             String        @id @default(uuid())
  organizationId String
  createdById    String
  format         ExportFormat
  status         ExportStatus  @default(QUEUED)
  listId         String?
  projectId      String?
  searchId       String?
  filterJson     Json?
  storagePath    String?
  googleSheetId  String?
  rowCount       Int?
  error          String?
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([organizationId, status])
}

model BackgroundJob {
  id             String    @id @default(uuid())
  organizationId String?
  queue          String
  name           String
  payload        Json
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([queue, status])
}

model ProviderConfig {
  id                  String   @id @default(uuid())
  organizationId      String
  provider            String
  enabled             Boolean  @default(true)
  apiKeyEncrypted     String?
  dailyBudget         Int?
  metadata            Json?
  termsAcceptedAt     DateTime?
  termsAcceptedBy     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

/// Per-organization outreach compliance settings. Required by CAN-SPAM
/// (truthful sender identity, physical mailing address, opt-out) and GDPR
/// Art. 14 (disclose data source on first contact). Outreach send paths
/// MUST refuse to dispatch if these are missing.
model OutreachSettings {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  senderName           String?
  senderCompany        String?
  senderEmail          String?
  replyToEmail         String?
  mailingAddress       String?
  unsubscribeUrl       String?
  citeProviderInBody   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Outreach suppression list. Once an address lands here it must never
/// receive further marketing email from this org. We hash the email so the
/// suppression list itself doesn't leak a raw PII corpus.
model OutreachSuppression {
  id             String   @id @default(uuid())
  organizationId String
  emailHash      String
  reason         String   @default("UNSUBSCRIBE")
  source         String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, emailHash])
  @@index([organizationId, createdAt])
}

/// In-app notification feed. Currently only `LEADS_DISCOVERED` is emitted —
/// fired by the worker after a scheduled search inserts new leads. Webhook
/// + email digest delivery are layered on top of these rows.
model Notification {
  id             String   @id @default(uuid())
  organizationId String
  /// LEADS_DISCOVERED | SEARCH_FAILED | (future)
  kind           String
  title          String
  body           String
  /// Optional deep-link path within the app, e.g. /leads?discoveredWithin=24h
  href           String?
  /// Free-form structured payload for the row (lead ids, counts, etc.).
  data           Json?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, readAt, createdAt])
  @@index([organizationId, kind, createdAt])
}

/// Audit log of edits made to a Search. One row per save, with a structured
/// diff of changed fields (`{ field: { from, to } }`).
model SearchEdit {
  id             String   @id @default(uuid())
  organizationId String
  searchId       String
  /// Internal Crawlix User.id of the editor. Nullable for system edits.
  editedById     String?
  /// Diff payload: { fieldName: { from: any, to: any } }
  diff           Json
  createdAt      DateTime @default(now())

  @@index([organizationId, searchId, createdAt])
}

/// Audit log of edits made to a Project. Same shape as SearchEdit.
model ProjectEdit {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  editedById     String?
  diff           Json
  createdAt      DateTime @default(now())

  @@index([organizationId, projectId, createdAt])
}

/// Website Intelligence & Competitor Analysis report. One report covers a
/// primary business URL plus N competitor URLs. Audits are stored as JSON
/// (reusing the WebsiteAuditResult shape from the worker pipeline). Generated
/// asynchronously by the `intel.build` job.
model WebsiteIntelReport {
  id             String   @id @default(uuid())
  organizationId String
  /// Optional link to the originating Lead.
  leadId         String?
  /// Display label for the report (e.g. "Smith Dental — Aug 2025").
  title          String
  /// Primary business URL being analysed.
  primaryUrl     String
  /// Free-form business category (e.g. "dentist", "plumber"). Used as the
  /// keyword when auto-detecting competitors via Google Places searchNearby.
  category       String?
  /// Locality context for competitor discovery.
  city           String?
  country        String?
  /// "queued" | "running" | "complete" | "failed".
  status         String   @default("queued")
  /// Error message if status = "failed".
  errorMessage   String?
  /// Full audit + comparison payload (see worker pipeline).
  /// Shape: { primary: WebsiteAuditResult, competitors: [...], comparison: {...}, gaps: [...], recommendations: [...] }
  summaryJson    Json?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  competitors    WebsiteIntelCompetitor[]

  @@index([organizationId, createdAt])
  @@index([organizationId, leadId])
}

/// One competitor row per WebsiteIntelReport. Stores the resolved URL plus
/// the audit payload so the report page can render comparisons without
/// re-running the audit.
model WebsiteIntelCompetitor {
  id             String   @id @default(uuid())
  organizationId String
  reportId       String
  /// Either user-provided or auto-detected via Google Places.
  source         String   @default("manual")
  name           String?
  url            String
  /// WebsiteAuditResult JSON — populated once the audit finishes.
  auditJson      Json?
  /// "queued" | "complete" | "failed".
  status         String   @default("queued")
  errorMessage   String?
  createdAt      DateTime @default(now())
  report         WebsiteIntelReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, reportId])
}


model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  target         String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

// =============================================================================
// CRM — Pipelines, Deals, Activities, Proposals (Phase 1)
// FK constraints + RLS policies are added in
// packages/db/migrations/0011_crm_pipeline.sql.
// Models are intentionally self-contained (no @relation blocks to existing
// models) so this migration can land without modifying the legacy schema.
// =============================================================================

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityKind {
  NOTE
  EMAIL_OUT
  EMAIL_IN
  CALL
  TASK
  STAGE_CHANGE
  SYSTEM
}

enum ProposalStatus {
  DRAFT
  READY
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

model PipelineStage {
  id          String   @id @default(uuid())
  organizationId String
  pipelineId  String
  name        String
  /// 0-based ordering within the pipeline (DISCOVERY=0, PROPOSAL=1, …).
  position    Int
  /// Sales-stage probability 0–100 used for forecasting.
  probability Int      @default(20)
  /// Marks the stage as a terminal "won" or "lost" state.
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([organizationId, pipelineId, position])
  @@unique([pipelineId, position])
}

model Deal {
  id             String     @id @default(uuid())
  organizationId String
  pipelineId     String
  stageId        String
  /// Optional originating lead. Nullable so deals can be created manually.
  leadId         String?
  /// Set when the deal moves to a Won stage and a Project is auto-created.
  projectId      String?    @unique
  title          String
  amountCents    Int        @default(0)
  currency       String     @default("USD")
  status         DealStatus @default(OPEN)
  ownerUserId    String?
  expectedCloseAt DateTime?
  closedAt       DateTime?
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId, stageId])
  @@index([organizationId, leadId])
  @@index([organizationId, status])
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  /// Always set — every activity belongs to a deal context.
  dealId         String
  /// Optional secondary link to the underlying lead.
  leadId         String?
  /// Author user; null for system-generated activities.
  userId         String?
  kind           ActivityKind
  /// Human-readable summary; full body lives in metadata for richer kinds.
  summary        String
  metadata       Json?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, dealId, occurredAt])
  @@index([organizationId, leadId, occurredAt])
}

model Proposal {
  id             String         @id @default(uuid())
  organizationId String
  dealId         String
  leadId         String?
  version        Int            @default(1)
  status         ProposalStatus @default(DRAFT)
  /// Rendered HTML body produced by the AI generator.
  bodyHtml       String
  /// Optional public share token. Hosted page reads via this.
  shareToken     String?        @unique
  /// AI provenance — useful for cost reports and quality audits.
  aiProvider     String?
  aiModel        String?
  aiPromptTokens Int?
  aiCompletionTokens Int?
  aiCostUsd      Decimal?       @db.Decimal(10, 6)
  generatedById  String?
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, dealId])
  @@index([organizationId, status])
}

