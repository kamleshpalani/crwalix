// packages/db/prisma/schema.prisma
// Crawlix SaaS — multi-tenant schema.
// Notes:
//  - Every tenant-scoped table has organizationId + a Postgres RLS policy
//    (see packages/db/migrations/0001_rls.sql — added in Phase 1).
//  - JSONB is used for raw/normalized provider payloads and audit metadata.
//  - The previously scaffolded /packages/database is deprecated in favor of
//    this package and will be removed once Phase 1 code migrates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  /// Full sales access: leads, outreach, CRM, proposals, quotes.
  SALES
  /// Project delivery: projects, tasks, milestones, files, portal invites.
  PROJECT_MANAGER
  /// Finance access: invoices, billing history, export.
  FINANCE
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  NONE
}

enum Plan {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum LeadStatus {
  NEW
  VERIFIED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  NOT_INTERESTED
  CONVERTED
  CLOSED
  // Deprecated values, retained for backwards compatibility with rows
  // created before the lifecycle was redesigned. Treat as legacy.
  ENRICHED
  REVIEWED
  EXPORTED
  ARCHIVED
}

enum WebsiteStatus {
  EXISTS
  EXISTS_MISSING_IN_SOURCE
  LIKELY_NONE
  HIGH_CONFIDENCE_NONE
  UNKNOWN
}

enum PriorityTier {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  NOT_RECOMMENDED
}

enum EnrichmentKind {
  WEBSITE_VALIDATION
  EMAIL
  EMAIL_VERIFY
  SOCIAL
  COMPANY
  CONTACT
  /// §8.1 — AI-generated business description from lead signals.
  BUSINESS_DESCRIPTION
  /// §8.1 — AI-generated review summary from rating + review count.
  REVIEW_SUMMARY
  /// §9.3 — AI-powered full website audit report.
  WEBSITE_REPORT
}

enum EnrichmentStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  /// §8.2 — Some enrichment steps succeeded, others failed/skipped.
  PARTIAL
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum ExportStatus {
  QUEUED
  BUILDING
  READY
  FAILED
}

enum ExportFormat {
  CSV
  XLSX
  GOOGLE_SHEETS
}

enum BusinessStatus {
  OPERATIONAL
  CLOSED_TEMP
  CLOSED_PERM
  UNKNOWN
}

model User {
  id          String   @id @default(uuid())
  clerkId     String   @unique
  email       String   @unique
  fullName    String?
  firstName   String?
  lastName    String?
  phone       String?
  avatarUrl   String?
  status      UserStatus @default(ACTIVE)
  /// Platform-level Super Admin (cross-tenant). Distinct from per-org Role.
  isSuperAdmin Boolean  @default(false)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships OrganizationMember[]
  auditLogs   AuditLog[]
  dsarRequests DsarRequest[]
}

model Organization {
  id               String   @id @default(uuid())
  slug             String   @unique
  clerkOrgId       String?  @unique
  name             String
  plan             Plan     @default(FREE)
  status           OrgStatus @default(ACTIVE)
  billingStatus    BillingStatus @default(NONE)
  /// Public company contact info (Section 6.2).
  companyEmail     String?
  companyPhone     String?
  website          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  /// Soft caps enforced by the usage layer; null = unlimited.
  aiUsageLimit     Int?
  leadSearchLimit  Int?
  /// When true, all org members must complete a second factor (MFA/2FA)
  /// before accessing tenant-scoped resources (Spec 6.1).
  requireMfa       Boolean  @default(false)
  stripeCustomerId String?  @unique
  /// Optional outbound webhook fired when newly-discovered leads arrive
  /// from a scheduled search. Slack-compatible incoming webhooks work too.
  notificationWebhookUrl String?
  /// Optional digest email recipient. Defaults to the org owner if blank.
  notificationEmail      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  members          OrganizationMember[]
  projects         Project[]
  subscription     Subscription?
  usageLogs        UsageLog[]
  apiKeys          ApiKey[]
  dsarRequests     DsarRequest[]
  providerConfigs  ProviderConfig[]
  outreachSettings OutreachSettings?
  outreachSuppressions OutreachSuppression[]
  notifications    Notification[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Subscription {
  id                   String    @id @default(uuid())
  organizationId       String    @unique
  stripeSubscriptionId String?   @unique
  plan                 Plan
  status               String
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id])
}

model UsageLog {
  id             String   @id @default(uuid())
  organizationId String
  kind           String
  units          Int
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  /// Optional link back to the deal that triggered project kickoff.
  /// One project per won deal — UNIQUE so the kickoff is idempotent.
  dealId         String?  @unique
  /// Convenience denorm of the originating lead (for quick filters).
  leadId         String?
  /// PLANNING | ACTIVE | PAUSED | COMPLETED | ARCHIVED. Plain text so we
  /// don't have to ship a Postgres enum migration just for five values.
  status         String   @default("PLANNING")
  kickoffAt      DateTime?
  completedAt    DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searches       Search[]
  leadLists      LeadList[]
  tasks          ProjectTask[]
  milestones     Milestone[]
  files          ProjectFile[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, leadId])
}

/// Kickoff checklist items for a Project. Created by `seed_default_project_tasks`
/// when a deal flips to a Won stage; manually editable thereafter.
model ProjectTask {
  id              String   @id @default(uuid())
  organizationId  String
  projectId       String
  title           String
  description     String?
  /// TODO | IN_PROGRESS | DONE | BLOCKED.
  status          String   @default("TODO")
  /// Display order within the project. Lower = top.
  position        Int      @default(0)
  dueAt           DateTime?
  assigneeUserId  String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, position])
  @@index([organizationId, status])
}

/// Billable checkpoint within a Project. When marked COMPLETED with
/// `autoInvoice=true`, the worker auto-creates a Stripe invoice for
/// `amountCents`. Tracks the resulting invoice for idempotency.
model Milestone {
  id              String   @id @default(uuid())
  organizationId  String
  projectId       String
  title           String
  description     String?
  /// PENDING | IN_PROGRESS | COMPLETED | CANCELED.
  status          String   @default("PENDING")
  /// Display order within the project.
  position        Int      @default(0)
  /// Billable amount for this milestone in cents. 0 = non-billable checkpoint.
  amountCents     Int      @default(0)
  currency        String   @default("USD")
  /// When true, completing the milestone auto-creates an Invoice.
  autoInvoice     Boolean  @default(false)
  /// Idempotency: invoice generated when this milestone was completed.
  invoiceId       String?  @unique
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, position])
  @@index([organizationId, status])
}

/// File attached to a project. Actual bytes live in Supabase Storage; this
/// table stores metadata + the canonical storage path. Public access is
/// served via short-lived signed URLs (see `apps/web/src/server/services/file.service.ts`).
model ProjectFile {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  /// Storage bucket + path (e.g., "project-files/<orgId>/<projectId>/<uuid>-name.pdf").
  /// Bucket is implicit (single bucket per env via SUPABASE_STORAGE_BUCKET).
  storagePath    String   @unique
  filename       String
  mimeType       String
  sizeBytes      Int
  /// SHA-256 of file contents — for dedupe and integrity checks.
  contentHash    String?
  uploadedById   String
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}

/// Persistent grant: an external email is allowed read access to a Project
/// via the client portal. Created when the project owner invites a client.
/// Multiple grants per project are allowed (e.g., point-of-contact + boss).
model PortalAccess {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  email          String
  /// Display name (optional — falls back to email).
  name           String?
  /// PENDING (invited, not yet logged in) | ACTIVE | REVOKED.
  status         String   @default("PENDING")
  invitedById    String
  invitedAt      DateTime @default(now())
  lastLoginAt    DateTime?
  revokedAt      DateTime?

  @@unique([projectId, email])
  @@index([organizationId, projectId])
  @@index([email])
}

/// One-shot magic link token. SHA-256 hash of the random secret is stored.
/// Consumed (deleted) on first successful verification.
model PortalLoginToken {
  id             String   @id @default(uuid())
  organizationId String
  portalAccessId String
  /// SHA-256 hex of the secret. Raw secret never persisted.
  tokenHash      String   @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([portalAccessId])
  @@index([expiresAt])
}

model Search {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  niche          String?
  keyword        String?
  country        String?
  state          String?
  city           String?
  postalCode     String?
  radiusMeters   Int?
  resultLimit    Int      @default(100)
  provider       String
  /// Per-search ingest filter: ALL | NO_WEBSITE | HIGH_OR_MED.
  leadFocus      String   @default("ALL")
  /// Recurring schedule. NULL or 'NONE' = one-shot. Allowed: NONE | DAILY | WEEKLY | MONTHLY.
  scheduleFrequency String  @default("NONE")
  /// When the next scheduled run should fire (UTC). Null when one-shot.
  nextRunAt         DateTime?
  /// Last time a run was kicked off for this search.
  lastRunAt         DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs           SearchRun[]

  @@index([organizationId, projectId])
  @@index([scheduleFrequency, nextRunAt])
}

model SearchRun {
  id             String    @id @default(uuid())
  organizationId String
  searchId       String
  status         JobStatus @default(QUEUED)
  provider       String
  totalFetched   Int       @default(0)
  totalInserted  Int       @default(0)
  totalDuplicate Int       @default(0)
  cost           Int       @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  search         Search    @relation(fields: [searchId], references: [id], onDelete: Cascade)
  leads          LeadSource[]

  @@index([organizationId, searchId])
}

model Lead {
  id                String   @id @default(uuid())
  organizationId    String
  externalPlaceId   String
  provider          String
  name              String
  nameNormalized    String
  categoryPrimary   String?
  categories        String[] @default([])
  phone             String?
  phoneNormalized   String?
  email             String?
  emailNormalized   String?
  ownerName         String?
  facebookUrl       String?
  instagramUrl      String?
  googleProfileUrl  String?
  /// Recommended sales pitches derived from website audit + priority.
  /// Values: NEW_WEBSITE | REDESIGN | SEO | BOOKING_SYSTEM | CONTACT_FORM | MOBILE_REDESIGN.
  servicePitch      String[]       @default([])
  website           String?
  websiteStatus     WebsiteStatus  @default(UNKNOWN)
  /// Outcome of latest website-validation enrichment.
  /// One of WebsiteHealth (FRESH | NEEDS_REVIEW | OUTDATED | UNREACHABLE | NOT_AUDITED).
  websiteHealth     String         @default("NOT_AUDITED")
  /// 0–100 health score. 100 = pristine modern site, 0 = unreachable.
  websiteHealthScore Int?
  /// Structured findings (issues + signals) from the auditor.
  websiteAudit      Json?
  websiteAuditedAt  DateTime?
  sourceUrl         String?
  address           String?
  addressNormalized String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  lat               Float?
  lng               Float?
  businessStatus    BusinessStatus @default(UNKNOWN)
  rating            Float?
  reviewCount       Int?
  score             Int?
  priorityTier      PriorityTier?
  scoreBreakdown    Json?
  /// AI-assigned 0-100 score (from `lead.score` task via scoreLeadWithAi).
  aiScore           Int?
  /// AI tier: CRITICAL | HIGH | MEDIUM | LOW
  aiScoreTier       String?
  /// Short reasoning paragraph from the AI scorer.
  aiScoreReason     String?
  /// Timestamp of last AI scoring run.
  aiScoredAt        DateTime?
  /// Business-scale classification: MICRO | SMALL | MEDIUM | LARGE | ENTERPRISE | UNKNOWN.
  /// Derived from public signals (categories, reviews, website tech, etc.).
  businessScale     String         @default("UNKNOWN")
  /// 0–100 confidence in the classification.
  businessScaleConfidence Int?
  /// Contributing signals + raw bucket scores from the classifier.
  businessScaleSignals Json?
  /// §11 — Number of physical locations / branches.
  locationCount     Int?
  /// §11 — Publicly available revenue band string, e.g. "$1M–$10M". Legal sources only.
  revenueEstimate   String?
  /// §11 — Estimated employee headcount from public sources.
  employeeEstimate  Int?
  /// §11 — LinkedIn employee-count band string, e.g. "11-50" or "1001-5000".
  linkedinEmployeeRange String?
  /// User-facing industry (free-form, distinct from auto-derived categories).
  industry          String?
  /// Operating hours payload (provider-specific JSON, normalized when possible).
  openingHours      Json?
  /// User this lead is assigned to (sales rep). FK to internal User.id, nullable.
  assignedUserId    String?
  /// CRM pipeline stage on the lead itself (independent of any Deal).
  crmStage          String?
  /// 0–100 multi-channel digital presence score (website + social + reviews).
  digitalPresenceScore Int?
  /// Convenience copy of Google Place ID when provider=google_places.
  googlePlaceId     String?
  /// Convenience copy of Yelp business ID when provider=yelp_fusion.
  yelpBusinessId    String?
  status            LeadStatus     @default(NEW)
  notes             String?
  tags              String[]       @default([])
  firstSeenAt       DateTime       @default(now())
  lastSeenAt        DateTime       @default(now())
  lastEnrichedAt    DateTime?
  /// §8.1 — AI-generated business description derived from public signals.
  businessDescription String?
  /// §8.1 — AI-generated summary of business reviews (from rating + count).
  reviewSummary     String?
  /// §8.1 — Technology stack detected via website audit (BuiltWith + heuristics).
  techStack         String[]       @default([])
  /// §8.1 — Page <title> text extracted during website enrichment.
  seoTitle          String?
  /// §8.1 — Meta description extracted during website enrichment.
  seoDescription    String?
  /// §8.1 — Whether the website has a mobile viewport meta tag.
  isMobileReady     Boolean?
  /// §8.1 — Whether a contact form / mailto link was found on the website.
  hasContactForm    Boolean?
  /// §9.2 — Whether basic SEO meta tags (title + description) are present.
  hasSeoBasics      Boolean?
  /// §9.2 — Whether Open Graph / schema.org markup is present.
  hasSchemaMarkup   Boolean?
  /// §9.2 — Whether a web-analytics snippet (GA, GTM, etc.) was detected.
  hasAnalytics      Boolean?
  /// §9.2 — Whether an online booking / appointment form was found.
  hasBookingForm    Boolean?
  /// §9.2 — Whether a lead-capture / enquiry form was found.
  hasLeadCaptureForm Boolean?
  /// §8.2 — Aggregate enrichment lifecycle status.
  /// One of: NOT_STARTED | IN_PROGRESS | COMPLETED | FAILED | PARTIALLY_COMPLETED
  enrichmentStatus  String         @default("NOT_STARTED")
  /// §9.1 — 7-state website classification derived from the website audit.
  /// One of: NO_WEBSITE | WEBSITE_FOUND | NOT_LOADING | OUTDATED | MODERN | NEEDS_REDESIGN | TECHNICAL_ISSUES
  websiteClassification String     @default("NO_WEBSITE")
  /// §9.3 — AI-generated full website audit report (JSON).
  websiteAiReport   Json?
  rawPayload        Json
  normalizedPayload Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sources           LeadSource[]
  enrichments       Enrichment[]
  scores            LeadScore[]
  listMemberships   LeadListItem[]
  fieldHistory      LeadFieldHistory[]
  mergeHistoryAsCanonical LeadMergeHistory[] @relation("LeadMergeCanonical")
  mergeHistoryAsPending   LeadMergeHistory[] @relation("LeadMergePending")

  @@unique([organizationId, provider, externalPlaceId])
  @@index([organizationId, nameNormalized])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, websiteStatus])
  @@index([organizationId, priorityTier, score])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, crmStage])
  @@index([organizationId, googlePlaceId])
  @@index([organizationId, yelpBusinessId])
  @@index([organizationId, enrichmentStatus])
  @@index([organizationId, websiteClassification])
}

/// Per-field change log for a Lead.  One row per changed field per update.
/// Source values: 'user' | 'enrichment' | 'import' | 'webhook' | 'system'.
model LeadFieldHistory {
  id             String   @id @default(uuid())
  organizationId String
  leadId         String
  field          String
  oldValue       String?
  newValue       String?
  changedBy      String?
  source         String   @default("user")
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
}

/// Audit trail of cross-provider lead merges. One row per duplicate hit
/// folded into a canonical lead. Lets us replay merges and prove the same
/// physical business wasn't double-charged against the org's quota.
model LeadMergeHistory {
  id                String   @id @default(uuid())
  organizationId    String
  canonicalLeadId   String
  /// Reason: 'exact' | 'phone' | 'website' | 'name_address' | 'name_geo' | 'email' | 'place_id' | 'manual' | 'name_city'.
  reason            String
  /// 0..1 match confidence at merge time.
  confidence        Float
  /// Provider that produced the duplicate hit (google_places, yelp_fusion, ...).
  fromProvider      String?
  /// External place id from the duplicate hit, if any.
  fromExternalId    String?
  /// Snapshot of the incoming normalized lead payload.
  payload           Json?
  /// 'auto_merged' (default) | 'pending_review' | 'confirmed' | 'rejected'.
  status            String   @default("auto_merged")
  /// When status='pending_review', the candidate lead we created instead of
  /// auto-merging. On approve we fold this lead into canonical and delete it.
  pendingLeadId     String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())

  canonical         Lead     @relation("LeadMergeCanonical", fields: [canonicalLeadId], references: [id], onDelete: Cascade)
  pending           Lead?    @relation("LeadMergePending",   fields: [pendingLeadId],   references: [id], onDelete: Cascade)

  @@index([organizationId, canonicalLeadId])
  @@index([canonicalLeadId, createdAt])
  @@index([organizationId, status])
  @@index([pendingLeadId])
}

model LeadSource {
  id          String   @id @default(uuid())
  leadId      String
  searchRunId String
  provider    String
  rawPayload  Json
  createdAt   DateTime @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  searchRun   SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadScore {
  id             String       @id @default(uuid())
  leadId         String
  score          Int
  priorityTier   PriorityTier
  breakdown      Json
  rulesetVersion String
  createdAt      DateTime     @default(now())
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Enrichment {
  id             String           @id @default(uuid())
  organizationId String
  leadId         String
  kind           EnrichmentKind
  provider       String
  status         EnrichmentStatus @default(QUEUED)
  attempts       Int              @default(0)
  rawResult      Json?
  normalized     Json?
  error          String?
  cost           Int              @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, kind])
}

model LeadList {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  description    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items          LeadListItem[]

  @@index([organizationId])
}

model LeadListItem {
  id        String   @id @default(uuid())
  listId    String
  leadId    String
  createdAt DateTime @default(now())
  list      LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([listId, leadId])
}

model ExportJob {
  id             String        @id @default(uuid())
  organizationId String
  createdById    String
  format         ExportFormat
  status         ExportStatus  @default(QUEUED)
  listId         String?
  projectId      String?
  searchId       String?
  filterJson     Json?
  storagePath    String?
  googleSheetId  String?
  rowCount       Int?
  error          String?
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?

  @@index([organizationId, status])
}

model BackgroundJob {
  id             String    @id @default(uuid())
  organizationId String?
  queue          String
  name           String
  payload        Json
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([queue, status])
}

model ProviderConfig {
  id                  String   @id @default(uuid())
  organizationId      String
  provider            String
  enabled             Boolean  @default(true)
  apiKeyEncrypted     String?
  dailyBudget         Int?
  metadata            Json?
  termsAcceptedAt     DateTime?
  termsAcceptedBy     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

/// Per-organization outreach compliance settings. Required by CAN-SPAM
/// (truthful sender identity, physical mailing address, opt-out) and GDPR
/// Art. 14 (disclose data source on first contact). Outreach send paths
/// MUST refuse to dispatch if these are missing.
model OutreachSettings {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  senderName           String?
  senderCompany        String?
  senderEmail          String?
  replyToEmail         String?
  mailingAddress       String?
  unsubscribeUrl       String?
  citeProviderInBody   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Outreach suppression list. Once an address lands here it must never
/// receive further marketing email from this org. We hash the email so the
/// suppression list itself doesn't leak a raw PII corpus.
model OutreachSuppression {
  id             String   @id @default(uuid())
  organizationId String
  emailHash      String
  reason         String   @default("UNSUBSCRIBE")
  source         String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, emailHash])
  @@index([organizationId, createdAt])
}

/// In-app notification feed. Currently only `LEADS_DISCOVERED` is emitted —
/// fired by the worker after a scheduled search inserts new leads. Webhook
/// + email digest delivery are layered on top of these rows.
model Notification {
  id             String   @id @default(uuid())
  organizationId String
  /// LEADS_DISCOVERED | SEARCH_FAILED | (future)
  kind           String
  title          String
  body           String
  /// Optional deep-link path within the app, e.g. /leads?discoveredWithin=24h
  href           String?
  /// Free-form structured payload for the row (lead ids, counts, etc.).
  data           Json?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, readAt, createdAt])
  @@index([organizationId, kind, createdAt])
}

/// Audit log of edits made to a Search. One row per save, with a structured
/// diff of changed fields (`{ field: { from, to } }`).
model SearchEdit {
  id             String   @id @default(uuid())
  organizationId String
  searchId       String
  /// Internal Crawlix User.id of the editor. Nullable for system edits.
  editedById     String?
  /// Diff payload: { fieldName: { from: any, to: any } }
  diff           Json
  createdAt      DateTime @default(now())

  @@index([organizationId, searchId, createdAt])
}

/// Audit log of edits made to a Project. Same shape as SearchEdit.
model ProjectEdit {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  editedById     String?
  diff           Json
  createdAt      DateTime @default(now())

  @@index([organizationId, projectId, createdAt])
}

/// Website Intelligence & Competitor Analysis report. One report covers a
/// primary business URL plus N competitor URLs. Audits are stored as JSON
/// (reusing the WebsiteAuditResult shape from the worker pipeline). Generated
/// asynchronously by the `intel.build` job.
model WebsiteIntelReport {
  id             String   @id @default(uuid())
  organizationId String
  /// Optional link to the originating Lead.
  leadId         String?
  /// Display label for the report (e.g. "Smith Dental — Aug 2025").
  title          String
  /// Primary business URL being analysed.
  primaryUrl     String
  /// Free-form business category (e.g. "dentist", "plumber"). Used as the
  /// keyword when auto-detecting competitors via Google Places searchNearby.
  category       String?
  /// Locality context for competitor discovery.
  city           String?
  country        String?
  /// "queued" | "running" | "complete" | "failed".
  status         String   @default("queued")
  /// Error message if status = "failed".
  errorMessage   String?
  /// Full audit + comparison payload (see worker pipeline).
  /// Shape: { primary: WebsiteAuditResult, competitors: [...], comparison: {...}, gaps: [...], recommendations: [...] }
  summaryJson    Json?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  competitors    WebsiteIntelCompetitor[]

  @@index([organizationId, createdAt])
  @@index([organizationId, leadId])
}

/// One competitor row per WebsiteIntelReport. Stores the resolved URL plus
/// the audit payload so the report page can render comparisons without
/// re-running the audit.
model WebsiteIntelCompetitor {
  id             String   @id @default(uuid())
  organizationId String
  reportId       String
  /// Either user-provided or auto-detected via Google Places.
  source         String   @default("manual")
  name           String?
  url            String
  /// WebsiteAuditResult JSON — populated once the audit finishes.
  auditJson      Json?
  /// "queued" | "complete" | "failed".
  status         String   @default("queued")
  errorMessage   String?
  createdAt      DateTime @default(now())
  report         WebsiteIntelReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, reportId])
}


model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// =============================================================================
// GDPR / CCPA — Data Subject Access Requests (Phase 5.2)
// =============================================================================

enum DsarType {
  EXPORT  // Right to access / data portability
  ERASE   // Right to erasure ("right to be forgotten")
}

enum DsarStatus {
  PENDING    // Received, not yet processed
  PROCESSING // Worker picked it up
  COMPLETED  // Export delivered / erase executed
  FAILED     // Worker error; see `errorMessage`
}

model DsarRequest {
  id             String     @id @default(uuid())
  organizationId String
  userId         String     // The user making the request
  type           DsarType
  status         DsarStatus @default(PENDING)
  exportUrl      String?    // Signed download URL once export is ready
  exportExpiresAt DateTime? // When the download link expires
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime   @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId, userId])
  @@index([status, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  target         String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

// =============================================================================
// CRM — Pipelines, Deals, Activities, Proposals (Phase 1)
// FK constraints + RLS policies are added in
// packages/db/migrations/0011_crm_pipeline.sql.
// Models are intentionally self-contained (no @relation blocks to existing
// models) so this migration can land without modifying the legacy schema.
// =============================================================================

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityKind {
  NOTE
  EMAIL_OUT
  EMAIL_IN
  CALL
  TASK
  STAGE_CHANGE
  SYSTEM
}

enum ProposalStatus {
  DRAFT
  READY
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

enum OutreachMessageStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  SUPPRESSED
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SequenceRunStatus {
  RUNNING
  PAUSED
  COMPLETED
  REPLIED
  BOUNCED
  FAILED
  STOPPED
}

enum SequenceStepChannel {
  EMAIL
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

model PipelineStage {
  id          String   @id @default(uuid())
  organizationId String
  pipelineId  String
  name        String
  /// 0-based ordering within the pipeline (DISCOVERY=0, PROPOSAL=1, …).
  position    Int
  /// Sales-stage probability 0–100 used for forecasting.
  probability Int      @default(20)
  /// Marks the stage as a terminal "won" or "lost" state.
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([organizationId, pipelineId, position])
  @@unique([pipelineId, position])
}

model Deal {
  id             String     @id @default(uuid())
  organizationId String
  pipelineId     String
  stageId        String
  /// Optional originating lead. Nullable so deals can be created manually.
  leadId         String?
  /// Set when the deal moves to a Won stage and a Project is auto-created.
  projectId      String?    @unique
  title          String
  amountCents    Int        @default(0)
  currency       String     @default("USD")
  status         DealStatus @default(OPEN)
  ownerUserId    String?
  expectedCloseAt DateTime?
  /// Optional next follow-up reminder date set by the owner.
  followUpAt     DateTime?
  closedAt       DateTime?
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId, stageId])
  @@index([organizationId, leadId])
  @@index([organizationId, status])
  @@index([organizationId, followUpAt])
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  /// Always set — every activity belongs to a deal context.
  dealId         String
  /// Optional secondary link to the underlying lead.
  leadId         String?
  /// Author user; null for system-generated activities.
  userId         String?
  kind           ActivityKind
  /// Human-readable summary; full body lives in metadata for richer kinds.
  summary        String
  metadata       Json?
  /// Due date for TASK activities.
  dueAt          DateTime?
  /// Completion flag for TASK activities.
  isDone         Boolean      @default(false)
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, dealId, occurredAt])
  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, dealId, isDone, dueAt])
}

model Proposal {
  id             String         @id @default(uuid())
  organizationId String
  dealId         String
  leadId         String?
  version        Int            @default(1)
  status         ProposalStatus @default(DRAFT)
  /// Rendered HTML body produced by the AI generator.
  bodyHtml       String
  /// Optional public share token. Hosted page reads via this.
  shareToken     String?        @unique
  /// AI provenance — useful for cost reports and quality audits.
  aiProvider     String?
  aiModel        String?
  aiPromptTokens Int?
  aiCompletionTokens Int?
  aiCostUsd      Decimal?       @db.Decimal(10, 6)
  generatedById  String?
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, dealId])
  @@index([organizationId, status])
}

/// Single outbound email send. One row per `sendOutreach()` call. Used for
/// tracking opens / unsubscribes / bounces and for audit & deliverability.
/// Subject + HTML body are persisted post-render so we can replay exactly
/// what the recipient saw.
model OutreachMessage {
  id             String                @id @default(uuid())
  organizationId String
  /// Optional originating lead for CRM joins.
  leadId         String?
  /// Optional deal context (e.g. proposal follow-up).
  dealId         String?
  /// Optional sequence step that produced this send (Phase 1.6).
  sequenceRunId  String?
  /// Recipient email at send-time. Stored verbatim for audit; suppression
  /// is keyed off the hashed form in `OutreachSuppression`.
  toEmail        String
  fromEmail      String
  subject        String
  bodyHtml       String
  bodyText       String?
  /// Provider message id (Resend / SES / SMTP). Used for inbound webhook joins.
  providerId     String?
  provider       String?
  status         OutreachMessageStatus @default(QUEUED)
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  repliedAt      DateTime?
  bouncedAt      DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, dealId, createdAt])
  @@index([providerId])
}

/// Outreach cadence template: a named, ordered list of email steps.
/// One row per template — runs are spawned in `SequenceRun`. Steps are
/// keyed off `position`; `delayHours` is computed relative to the
/// previous step's send time (0 means "send immediately on start").
model Sequence {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         SequenceStatus @default(DRAFT)
  /// Optional FROM override; falls back to OutreachSettings.senderEmail.
  fromEmail      String?
  /// Optional Reply-To override; falls back to OutreachSettings.replyToEmail.
  replyToEmail   String?
  /// Quiet-hours window expressed in 0-23 ints (org-local TZ on Organization).
  /// When set, sends scheduled outside the window shift forward to the next
  /// open slot. NULL = no quiet hours.
  quietStartHour Int?
  quietEndHour   Int?
  /// IANA timezone name (e.g. "America/Los_Angeles") for quiet hours.
  /// Defaults to "UTC" at runtime.
  timezone       String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  steps          SequenceStep[]
  runs           SequenceRun[]

  @@index([organizationId, status])
  @@unique([organizationId, name])
}

model SequenceStep {
  id              String              @id @default(uuid())
  organizationId  String
  sequenceId      String
  /// 0-based ordering. The first send always runs at position 0.
  position        Int
  channel         SequenceStepChannel @default(EMAIL)
  /// Hours to wait after the prior step's send before dispatching this one.
  /// `0` = send right after the prior step. The first step is always
  /// dispatched immediately.
  delayHours      Int                 @default(0)
  subjectTemplate String
  bodyTemplate    String
  /// When true the body is treated as raw HTML; otherwise wrapped in <p>.
  bodyIsHtml      Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sequence        Sequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([organizationId, sequenceId, position])
  @@unique([sequenceId, position])
}

/// Per-recipient instance of a Sequence. Created when a user starts
/// outreach against a Lead/Deal. The worker advances `currentStepIndex`
/// after each successful send and schedules the next tick with the
/// configured delay.
model SequenceRun {
  id              String            @id @default(uuid())
  organizationId  String
  sequenceId      String
  /// Recipient context — at least one of leadId / dealId is set.
  leadId          String?
  dealId          String?
  toEmail         String
  status          SequenceRunStatus @default(RUNNING)
  /// 0-based pointer to the *next* step to dispatch.
  currentStepIndex Int              @default(0)
  startedAt       DateTime          @default(now())
  lastSendAt      DateTime?
  nextRunAt       DateTime?
  completedAt    DateTime?
  pausedAt        DateTime?
  pauseReason     String?
  /// Per-run variable bag (e.g. lead.firstName) for template rendering.
  vars            Json?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sequence        Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextRunAt])
  @@index([organizationId, leadId])
  @@index([organizationId, dealId])
}

enum ReplyClassification {
  INTERESTED
  NOT_INTERESTED
  OUT_OF_OFFICE
  QUESTION
  UNSUBSCRIBE
  OTHER
}

/// Inbound email reply, captured from the Resend (or compatible) inbound
/// webhook. Matched back to the originating OutreachMessage via
/// `In-Reply-To` / `References` headers — when no match is found the row
/// is still kept so we can debug missed threads.
model InboundMessage {
  id                  String              @id @default(uuid())
  organizationId      String
  /// Resolved at ingestion when we can match the thread.
  outreachMessageId   String?
  sequenceRunId       String?
  leadId              String?
  dealId              String?
  /// Raw envelope info — useful for support and debugging.
  fromEmail           String
  fromName            String?
  toEmail             String
  subject             String
  /// Original `Message-ID` header of the inbound email.
  providerMessageId   String?             @unique
  /// `In-Reply-To` header used for thread matching.
  inReplyTo           String?
  references          String?
  bodyText            String?
  bodyHtml            String?
  /// AI classification (set asynchronously by the worker).
  classification      ReplyClassification?
  classificationConfidence Decimal?       @db.Decimal(4, 3)
  classificationReason String?
  classifiedAt        DateTime?
  /// Stamp once the classifier has acted (paused sequence, advanced deal).
  processedAt         DateTime?
  rawPayload          Json?
  receivedAt          DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([organizationId, receivedAt])
  @@index([organizationId, leadId])
  @@index([organizationId, dealId])
  @@index([organizationId, outreachMessageId])
  @@index([inReplyTo])
}

// =============================================================================
// Billing — Phase 2
// Invoice + Payment models, webhook idempotency table.
// FK constraints + RLS policies added in 0017_billing.sql.
// =============================================================================

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

/// An invoice for a project/deal — either subscription-derived (from Stripe)
/// or manually created for one-off project work.
model Invoice {
  id                   String        @id @default(uuid())
  organizationId       String
  /// Optional link to the won deal this invoice relates to.
  dealId               String?
  /// Optional project context.
  projectId            String?
  /// Mirrors the Stripe invoice id when synced from Stripe.
  stripeInvoiceId      String?       @unique
  status               InvoiceStatus @default(DRAFT)
  currency             String        @default("USD")
  /// Sub-total before tax, in minor units (cents).
  subtotalCents        Int           @default(0)
  taxCents             Int           @default(0)
  totalCents           Int           @default(0)
  /// Amount already collected (partial pay allowed).
  amountPaidCents      Int           @default(0)
  /// Amount still owing.
  amountDueCents       Int           @default(0)
  /// Human-readable invoice number e.g. INV-0042.
  number               String?       @unique
  memo                 String?
  /// Line items stored as JSON array [{description, quantity, unitCents, totalCents}].
  lineItems            Json          @default("[]")
  /// When to collect. Null = no deadline.
  dueAt                DateTime?
  /// When the Stripe payment page or self-hosted link was last sent.
  sentAt               DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  /// Stripe hosted invoice URL (for sharing with the client).
  hostedUrl            String?
  /// PDF download URL from Stripe or self-generated.
  pdfUrl               String?
  /// Module #14 — self-hosted invoice fields (set when created in-app, not via Stripe).
  title                String?
  customerName         String?
  customerEmail        String?
  /// Public share token for self-hosted invoice viewing/payment page.
  shareToken           String?       @unique
  metadata             Json?
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  payments             Payment[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, dealId])
  @@index([organizationId, projectId])
}

/// Single payment attempt (Stripe PaymentIntent or bank transfer).
model Payment {
  id                      String        @id @default(uuid())
  organizationId          String
  invoiceId               String
  stripePaymentIntentId   String?       @unique
  stripeChargeId          String?
  status                  PaymentStatus @default(PENDING)
  currency                String        @default("USD")
  amountCents             Int
  failureCode             String?
  failureMessage          String?
  refundedCents           Int           @default(0)
  paidAt                  DateTime?
  refundedAt              DateTime?
  metadata                Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  invoice                 Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, invoiceId])
  @@index([organizationId, status, createdAt])
}

/// Idempotency table for Stripe webhook events.
/// Prevents double-processing on retries — Stripe can deliver the same event
/// multiple times; we record the event id here before acting.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/// Per-org spend budgets — AI tokens, email sends, lead enrichments.
/// The AI router + job producers check these before dispatching costly ops.
model CostBudget {
  id             String   @id @default(uuid())
  organizationId String   @unique
  /// Max AI spend in USD cents per calendar month (null = unlimited).
  aiMonthlyLimitCents    Int?
  /// Max emails dispatched per calendar month (null = unlimited).
  emailMonthlyLimit      Int?
  /// Max enrichment calls per calendar month (null = unlimited).
  enrichMonthlyLimit     Int?
  /// When true the org has exceeded a limit and non-critical jobs are blocked.
  hardLimitReached       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([organizationId])
}

// =============================================================================
// Support inbox + KB — Phase 4.4 / 4.5
// FK + RLS in 0021_support.sql.
// =============================================================================

/// Customer-facing knowledge base article. Embeddings cached as Float[] so we
/// can do in-memory cosine similarity without requiring pgvector.
model KnowledgeArticle {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  content        String
  sourceUrl      String?
  /// 1536-dim text-embedding-3-small vector. Empty until ingest finishes.
  embedding      Float[]  @default([])
  /// Free-form tags for filtering inside the support agent context window.
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, updatedAt])
}

/// Inbound or outbound support thread. One ticket per customer issue.
model SupportTicket {
  id             String   @id @default(uuid())
  organizationId String
  /// Optional originating lead. Customers without lead records get null.
  leadId         String?
  subject        String
  /// OPEN | PENDING | RESOLVED | CLOSED. Plain text — no enum migration needed.
  status         String   @default("OPEN")
  /// Channel hint: email | portal | manual.
  channel        String   @default("manual")
  /// Optional human assignee for handoff workflows.
  assignedUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       SupportMessage[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, leadId])
}

/// One row per turn in a support thread. Authored by the user, the AI agent,
/// or a human teammate.
model SupportMessage {
  id             String   @id @default(uuid())
  organizationId String
  ticketId       String
  /// USER | AI | AGENT
  role           String
  content        String
  /// AI confidence 0..1; null for human messages.
  confidence     Float?
  /// IDs of KnowledgeArticle rows the AI cited; empty for non-AI rows.
  citedArticleIds String[] @default([])
  /// True when the AI judged itself unfit and asked for a human.
  needsHandoff   Boolean  @default(false)
  createdAt      DateTime @default(now())
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId, ticketId, createdAt])
}

// =============================================================================
// Quotes — Module #10. FK + RLS in 0022_quotes.sql.
// =============================================================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id             String      @id @default(uuid())
  organizationId String
  /// Optional CRM context.
  dealId         String?
  leadId         String?
  projectId      String?
  /// Human-readable e.g. Q-0042 (org-scoped sequential).
  number         String?
  title          String
  status         QuoteStatus @default(DRAFT)
  currency       String      @default("USD")
  /// Sub-total (sum of line totals).
  subtotalCents  Int         @default(0)
  /// Discount applied to subtotal (absolute cents).
  discountCents  Int         @default(0)
  /// Tax rate in basis points (e.g. 800 = 8.00%).
  taxRateBps     Int         @default(0)
  taxCents       Int         @default(0)
  totalCents     Int         @default(0)
  notes          String?
  terms          String?
  /// Public share token for customer accept/decline page.
  shareToken     String?     @unique
  validUntil     DateTime?
  sentAt         DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lineItems      QuoteLineItem[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, dealId])
  @@index([organizationId, projectId])
}

model QuoteLineItem {
  id             String  @id @default(uuid())
  organizationId String
  quoteId        String
  position       Int     @default(0)
  description    String
  /// Quantity * 1000 (3-decimal precision packed as int).
  quantityMilli  Int     @default(1000)
  unitPriceCents Int     @default(0)
  lineTotalCents Int     @default(0)
  createdAt      DateTime @default(now())
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([organizationId, quoteId, position])
}

// =============================================================================
// Service Packages — Module #10b. Predefined offerings the team can drop
// into quotes/proposals (Basic Website, E-Commerce, Maintenance, etc).
// FK + RLS + seed in 0029_service_packages.sql.
// =============================================================================
model ServicePackage {
  id             String   @id @default(uuid())
  organizationId String
  /// Stable slug e.g. "basic-website" (org-unique).
  slug           String
  name           String
  /// Short marketing summary shown in pickers.
  summary        String?
  /// Long description / sales copy (HTML allowed).
  description    String?
  category       String?
  /// Default price in minor units; team can override per-quote.
  priceCents     Int      @default(0)
  currency       String   @default("USD")
  /// Optional billing frequency: ONE_TIME / MONTHLY / YEARLY.
  billingCycle   String   @default("ONE_TIME")
  /// JSON array of bullet features e.g. ["5 pages","SEO basics"].
  features       Json     @default("[]")
  /// JSON array of default deliverables for proposals.
  deliverables   Json     @default("[]")
  /// JSON array of default scope items for quotes.
  scopeItems     Json     @default("[]")
  /// Default delivery window in days.
  deliveryDays   Int?
  /// Built-in templates seeded by 0029 are marked true so the UI can
  /// surface "Crawlix presets" vs org-authored entries.
  isBuiltIn      Boolean  @default(false)
  /// Soft-disable without deleting (preserves quote line item history).
  active         Boolean  @default(true)
  /// Sort weight for pickers; lower shows first.
  position       Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, active, position])
  @@index([organizationId, category])
}

// =============================================================================
// Contracts — Module #11. FK + RLS in 0023_contracts.sql.
// Lightweight in-app e-sign: customer types name + clicks Accept on a public
// share link; we capture name, IP, user-agent, timestamp, and a SHA-256 hash
// of the body at signing time as tamper-evidence.
// =============================================================================

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  CANCELED
  EXPIRED
}

model Contract {
  id             String         @id @default(uuid())
  organizationId String
  /// Optional CRM context.
  dealId         String?
  leadId         String?
  projectId      String?
  quoteId        String?
  /// Org-scoped sequential e.g. C-0042.
  number         String?
  title          String
  status         ContractStatus @default(DRAFT)
  /// Markdown or HTML body. Server-side stored verbatim — what was rendered
  /// to the customer at sign-time is locked once SIGNED.
  bodyMarkdown   String
  /// Counterparty contact for routing the share link.
  counterpartyName  String?
  counterpartyEmail String?
  /// Public share token for the customer-facing page.
  shareToken     String?        @unique
  /// SHA-256 of bodyMarkdown captured at the moment of signing. Empty until
  /// SIGNED. Used as a simple tamper-evidence check.
  bodyHashAtSign String?
  /// Typed name from the customer. Locked once SIGNED.
  signedName     String?
  signedAt       DateTime?
  signedIp       String?
  signedUserAgent String?
  declinedAt     DateTime?
  expiresAt      DateTime?
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, dealId])
  @@index([organizationId, projectId])
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

// =============================================================================
// Usage metering — Phase 2.7
// One row per billable event. Aggregated nightly for Stripe metered billing.
// FK + RLS in 0034_usage_events.sql.
// =============================================================================

/// Metered usage event. kind examples: ai.tokens | email.sent | lead.enriched | lead.discovered
model UsageEvent {
  id             String   @id @default(uuid())
  organizationId String
  /// Stable camelCase kind e.g. "ai.tokens", "email.sent", "lead.enriched".
  kind           String
  /// Arbitrary quantity (tokens, count, bytes — depends on kind).
  quantity       Int      @default(1)
  /// USD micro-cents cost captured at emit time (0 if not billable).
  costMicroCents Int      @default(0)
  /// Optional FK to the entity that triggered the event.
  refId          String?
  /// Free metadata (model name, provider, etc.)
  meta           Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, kind, createdAt])
  @@index([organizationId, createdAt])
}

// =============================================================================
// Consent records — Phase 5.2 (GDPR/CCPA)
// Append-only log of ToS/Privacy/Marketing acceptance per user+org pair.
// FK + RLS in 0035_consent_records.sql.
// =============================================================================

/// Append-only consent acceptance record. Never updated — only inserted.
model ConsentRecord {
  id             String   @id @default(uuid())
  organizationId String
  /// Clerk user ID of the accepting user.
  userId         String
  /// Policy kind: tos | privacy | marketing | data_processing
  kind           String
  /// Version of the policy document e.g. "2026-01-01".
  policyVersion  String
  /// True = accepted, false = revoked (e.g. marketing opt-out).
  accepted       Boolean  @default(true)
  /// Captured IP address.
  ip             String?
  /// Captured User-Agent header.
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, userId, kind, createdAt])
  @@index([organizationId, userId])
}

/// Module #21 — third-party integration connections per organization.
model Integration {
  id             String            @id @default(uuid())
  organizationId String
  /// Stable provider key e.g. slack, hubspot, gmail.
  provider       String
  status         IntegrationStatus @default(DISCONNECTED)
  /// Human label displayed in the UI (e.g. workspace/account name).
  accountLabel   String?
  /// Sensitive credentials. Never returned to the client untransformed.
  credentials    Json?
  /// Non-sensitive provider config (toggles, scopes, default folder, etc).
  config         Json?
  lastError      String?
  lastSyncedAt   DateTime?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

