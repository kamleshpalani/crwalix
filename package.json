{
  "name": "crawlix",
  "version": "0.1.0",
  "private": true,
  "description": "Crawlix — local business lead intelligence SaaS platform.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "legacy:dev": "tsx watch apps/backend/src/server.ts",
    "legacy:cli": "tsx apps/backend/src/cli.ts",
    "web:dev": "npm run dev --workspace @crawlix/web",
    "web:build": "npm run build --workspace @crawlix/web",
    "worker:dev": "npm run dev --workspace @crawlix/worker",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @crawlix/web && npm run typecheck --workspace @crawlix/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "db:generate": "npm run prisma:generate --workspace @crawlix/db",
    "db:migrate": "npm run prisma:migrate --workspace @crawlix/db",
    "db:deploy": "npm run prisma:deploy --workspace @crawlix/db",
    "db:studio": "npm run prisma:studio --workspace @crawlix/db"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@supabase/supabase-js": "^2.45.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "p-queue": "^8.0.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.46.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "eslint": "^9.8.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
