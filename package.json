{
  "name": "crawlix",
  "version": "0.1.0",
  "private": true,
  "description": "Crawlix — a pluggable scraping platform (Outscraper-style) built on Node.js + Playwright.",
  "type": "module",
  "bin": {
    "crawlix": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "p-queue": "^8.0.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.46.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "eslint": "^9.8.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
