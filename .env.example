# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Database (Supabase Postgres) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/crawlix
# Optional direct (non-pooled) connection, used by `prisma migrate` on Supabase.
DIRECT_URL=
# Supabase (for Auth / Storage / Realtime)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth (Clerk) ----
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for self-serve subscription plans.
# Create products + recurring prices in your Stripe dashboard and paste the
# price_xxx IDs here. Leave blank to hide that plan's "Upgrade" button.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=

# ---- Queue (Upstash Redis / BullMQ) ----
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ---- Providers ----
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
YELP_FUSION_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# ---- AI ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Google Sheets export (server OAuth) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# ---- Worker-only website validator (single-URL, user-initiated) ----
PLAYWRIGHT_HEADLESS=true
WEBSITE_FETCH_USER_AGENT=CrawlixBot/1.0 (+https://crawlix.example/bot)
WEBSITE_FETCH_TIMEOUT_MS=10000

# ---- Legacy (Phase 0 scraper prototype — to be removed once apps/web lands) ----
PORT=3000
HOST=0.0.0.0
HEADLESS=true
BROWSER_CONCURRENCY=2
NAV_TIMEOUT_MS=30000
DEFAULT_LOCALE=en-US
DEFAULT_USER_AGENT=
JOB_STORE=memory
