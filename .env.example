# Crawlix
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Playwright
HEADLESS=true
BROWSER_CONCURRENCY=2
NAV_TIMEOUT_MS=30000

# Defaults
DEFAULT_LOCALE=en-US
DEFAULT_USER_AGENT=

# Job store: "memory" (default) or "supabase"
JOB_STORE=memory

# Supabase (only required when JOB_STORE=supabase)
# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# anon key is exposed to the browser later (Phase 3/realtime)
SUPABASE_ANON_KEY=
